// 🅲 🅷 🅰 🅽 🅳 🅴 🆁
// ----------------------------------------------
// Syncthing ignore file
// Location: Root of folders being synced
// https://docs.syncthing.net/users/ignoring.html

// ----------------------------------------------
// Programs & Tools generated files and folders
// ----------------------------------------------

// Backblaze & editor swap artifacts
*~
.*.swp
sync.*
.bzvol

// MEGASync artifacts
/Rubbish
/.debris

// FreeFileSync artifacts
.sync.ffs_db*
sync.ffs_*

// ----------------------------------------------
// OS generated files
// ----------------------------------------------

// Windows artifacts
(?d)(?i)$RECYCLE.BIN
(?d)(?i)System Volume Information
(?d)(?i)desktop.ini
(?d)(?i)ehthumbs.db
(?d)(?i)Thumbs.db

// macOS artifacts
(?d)._*
(?d).DS_Store
(?d).localized
(?d).Spotlight-V100
(?d).Trashes
(?d).fseventsd

// Linux artifacts
(?d).Trash*
