// Zed settings
// Reference: https://zed.dev
{
    // =========================================================================
    // 1. Appearance & Typography
    // =========================================================================
    "theme": {
        "mode": "dark",
        "light": "Tokyo Night Light",
        "dark": "Tokyo Night Storm",
    },
    "icon_theme": {
        "mode": "dark",
        "light": "Colored Zed Icons Theme Dark",
        "dark": "Colored Zed Icons Theme Dark",
    },
    "ui_font_size": 12.0,
    "buffer_font_size": 12.0,

    // =========================================================================
    // 2. Editor & Formatting
    // =========================================================================
    "tab_size": 4,
    "format_on_save": "on",
    "indent_guides": {
        "enabled": true,
        "coloring": "indent_aware",
    },
    "minimap": {
        "show": "always",
        "thumb": "hover",
        "thumb_border": "full",
        "current_line_highlight": "all",
    },
    "file_types": {
        "Shell Script": ["env*"], // Treat ".env" and ".enrc" files as Shell Script for syntax highlighting
    },

    // =========================================================================
    // 3. Tabs, Windows & Session
    // =========================================================================
    "cli_default_open_behavior": "existing_window",
    "session": {
        "trust_all_worktrees": true,
    },
    "tabs": {
        "activate_on_close": "left_neighbour",
        "close_position": "right",
        "file_icons": true,
        "git_status": true,
        "show_close_button": "hover",
        "show_diagnostics": "all",
    },

    // =========================================================================
    // 4. Panels & Docks
    // =========================================================================
    "project_panel": {
        "dock": "left",
    },
    "outline_panel": {
        "dock": "left",
    },
    "git_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },

    // =========================================================================
    // 5. Terminal & Environment
    // =========================================================================
    "load_direnv": "direct",
    "terminal": {
        "dock": "bottom",
        "copy_on_select": true,
        "blinking": "on",
        "cursor_shape": "bar",
        "env": {
            "LIGHT_PROMPT": "true",
        },
        "shell": {
            "with_arguments": {
                "program": "fish",
                "args": ["--interactive"],
            },
        },
    },

    // =========================================================================
    // 6. AI & Agents
    // =========================================================================
    "disable_ai": false,
    "agent": {
        "dock": "right",
        "favorite_models": [],
        "model_parameters": [],
        "threads_sidebar": {
            "auto_open": false,
        },
    },
    "agent_servers": {
        "claude-acp": {
            "type": "registry",
        },
    },

    // =========================================================================
    // 7. Updates & Extensions
    // =========================================================================
    "auto_update": false,
    "auto_install_extensions": {
        "tokyo-night": true,
        "colored-zed-icons-theme": true,
    },

    // =========================================================================
    // 8. Platform Overrides
    // =========================================================================
    "windows": {
        "terminal": {
            "shell": {
                "program": "pwsh.exe -NoLogo",
            },
        },
    },
}
