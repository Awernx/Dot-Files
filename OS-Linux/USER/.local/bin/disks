#!/bin/sh

# 🅲 🅷 🅰 🅽 🅳 🅴 🆁
# -----------------------------------------------------------------
# Prints attached disks and mounted partitions in a bordered table

lsblk -e 7 -P -o NAME,TYPE,SIZE,ROTA,TRAN,MODEL,FSTYPE,MOUNTPOINT,PKNAME | awk -F'"' '
function max(a, b) { return (a > b ? a : b) }

function repeat(str, n,    out, i) {
    out = ""
    for (i = 0; i < n; i++) out = out str
    return out
}

function hline(left, mid, right) {
    printf "%s%s%s%s%s%s%s%s%s\n",
        left,  repeat("─", w1 + 2),
        mid,   repeat("─", w2 + 2),
        mid,   repeat("─", w3 + 2),
        mid,   repeat("─", w4 + 2),
        right
}

function print_row(c1, c2, c3, c4, c1_color, row_color, pad_extra) {
    if (row_color != "") {
        printf "│ %s%-*s\033[0m │ %s%-*s\033[0m │ %s%*s\033[0m │ %s%-*s\033[0m │\n",
            row_color, w1 + pad_extra, c1,
            row_color, w2, c2,
            row_color, w3, c3,
            row_color, w4, c4
    } else if (c1_color != "") {
        printf "│ %s%-*s\033[0m │ %-*s │ %*s │ %-*s │\n",
            c1_color, w1 + pad_extra, c1, w2, c2, w3, c3, w4, c4
    } else {
        printf "│ %-*s │ %-*s │ %*s │ %-*s │\n",
            w1 + pad_extra, c1, w2, c2, w3, c3, w4, c4
    }
}

BEGIN {
    # 0 in character-aware awk (gawk), 4 in byte-aware awk (mawk)
    utf8_offset = length("└─") - 2

    h1 = "DEVICE"; h2 = "TYPE / FS"; h3 = "SIZE"; h4 = "INFO / MOUNTPOINT"
    w1 = length(h1); w2 = length(h2); w3 = length(h3); w4 = length(h4)
}

{
    name = $2; type = $4; size = $6; rota = $8; tran = $10
    model = $12; fstype = $14; mnt = $16; pk = $18

    if (pk == "" && type != "part") {
        if (type == "rom") dtype = "DVD/CD"
        else if (model ~ /SD|MMC|Card|Reader|MS.PRO/) dtype = "Media Slot"
        else if (tran == "usb" && size == "0B") dtype = "Media Slot"
        else if (tran == "nvme") dtype = "NVMe"
        else if (rota == "1") dtype = "HDD"
        else if (rota == "0") dtype = "SSD"
        else dtype = "Disk"

        m_str = (model != "" ? model : "-")
        disk_count++
        disks[disk_count] = name
        d_type[name] = dtype
        d_size[name] = size
        d_info[name] = m_str

        w1 = max(w1, length(name))
        w2 = max(w2, length(dtype))
        w3 = max(w3, length(size))
        w4 = max(w4, length(m_str))

        if (mnt != "") {
            fs_str = (fstype != "" ? fstype : "-")
            p_label = "  └─ " name
            part_count[name]++
            idx = part_count[name]
            p_name[name, idx] = p_label
            p_fs[name, idx]   = fs_str
            p_size[name, idx] = size
            p_mnt[name, idx]  = mnt

            w1 = max(w1, length(p_label) - utf8_offset)
            w2 = max(w2, length(fs_str))
            w3 = max(w3, length(size))
            w4 = max(w4, length(mnt))
        }
    }
    else if (mnt != "") {
        parent = (pk != "" ? pk : name)
        if (!(parent in d_info)) {
            for (d in d_info) {
                if (index(parent, d) == 1) { parent = d; break }
            }
        }
        fs_str = (fstype != "" ? fstype : "-")
        p_label = "  └─ " name
        part_count[parent]++
        idx = part_count[parent]
        p_name[parent, idx] = p_label
        p_fs[parent, idx]   = fs_str
        p_size[parent, idx] = size
        p_mnt[parent, idx]  = mnt

        w1 = max(w1, length(p_label) - utf8_offset)
        w2 = max(w2, length(fs_str))
        w3 = max(w3, length(size))
        w4 = max(w4, length(mnt))
    }
}

END {
    hline("┌", "┬", "┐")
    print_row(h1, h2, h3, h4, "", "\033[1;93m", 0)
    hline("├", "┼", "┤")

    for (i = 1; i <= disk_count; i++) {
        d = disks[i]
        print_row(d, d_type[d], d_size[d], d_info[d], "\033[1;92m", "", 0)

        for (j = 1; j <= part_count[d]; j++) {
            print_row(p_name[d, j], p_fs[d, j], p_size[d, j], p_mnt[d, j], "", "", utf8_offset)
        }

        if (i < disk_count) {
            hline("├", "┼", "┤")
        }
    }

    hline("└", "┴", "┘")
}'
