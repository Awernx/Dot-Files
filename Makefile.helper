#!/bin/sh
# ==============================================================================
# Makefile.helper - POSIX Shell Deployment Helper (macOS & Linux)
# ==============================================================================
#
# Implements the 3-stage deployment pipeline for Unix systems:
#   Stage 1 (Filter):   Evaluates include/exclude rules (prefixes, globs, re:regex).
#                       - user & root: default-allow unless include is specified.
#                       - sudo_user:   default-deny unless include is specified.
#                       - exclude always takes precedence over include.
#   Stage 2 (Remap):    Applies `src:dst` path translations (from -*Map or inline
#                       `src:dst` in -*Copy).
#   Stage 3 (Strategy): Uses GNU Stow (--no-folding) for standard 1:1 symlinks
#                       (adopting any pre-existing symlinks that already point to
#                       the exact package source), direct symlinks for remapped
#                       or sudo_user items, and file copies (with permission
#                       preservation) for `copy` rules.
# ==============================================================================

set -eu

ACTION="${1:?Usage: Makefile.helper <deploy|remove> <package> [options]}"
PKG="${2:?Usage: Makefile.helper <deploy|remove> <package> [options]}"
shift 2

USER_TARGET="${USER_TARGET:-$HOME}"
SUDO_USER_TARGET="${SUDO_USER_TARGET:-$(getent passwd root 2>/dev/null | cut -d: -f6 || echo /root)}"
ROOT_TARGET="${ROOT_TARGET:-/}"
ROOT_GROUP="${ROOT_GROUP:-$(id -gn root 2>/dev/null || echo root)}"

# ------------------------------------------------------------------------------
# 1. Argument Parsing
# ------------------------------------------------------------------------------
SKIP_SUDO="0"

USER_INCLUDE=""
USER_EXCLUDE=""
USER_MAP=""
USER_COPY=""

SUDO_INCLUDE=""
SUDO_EXCLUDE=""
SUDO_MAP=""
SUDO_COPY=""

ROOT_INCLUDE=""
ROOT_EXCLUDE=""
ROOT_MAP=""
ROOT_COPY=""

while [ $# -gt 0 ]; do
    case "$1" in
        -SkipSudo)     SKIP_SUDO="${2:-0}"; shift 2 ;;
        -UserInclude)  USER_INCLUDE="${2:-}"; shift 2 ;;
        -UserExclude)  USER_EXCLUDE="${2:-}"; shift 2 ;;
        -UserMap)      USER_MAP="${2:-}"; shift 2 ;;
        -UserCopy)     USER_COPY="${2:-}"; shift 2 ;;
        -SudoInclude)  SUDO_INCLUDE="${2:-}"; shift 2 ;;
        -SudoExclude)  SUDO_EXCLUDE="${2:-}"; shift 2 ;;
        -SudoMap)      SUDO_MAP="${2:-}"; shift 2 ;;
        -SudoCopy)     SUDO_COPY="${2:-}"; shift 2 ;;
        -RootInclude)  ROOT_INCLUDE="${2:-}"; shift 2 ;;
        -RootExclude)  ROOT_EXCLUDE="${2:-}"; shift 2 ;;
        -RootMap)      ROOT_MAP="${2:-}"; shift 2 ;;
        -RootCopy)     ROOT_COPY="${2:-}"; shift 2 ;;
        # Windows-only flags accepted and ignored cleanly on Unix
        -UserHardlink|-UserJunction|-RootHardlink|-RootJunction) shift 2 ;;
        *) shift 1 ;;
    esac
done

STOW_BIN="$(command -v stow 2>/dev/null || true)"
GLOBAL_IGNORES=".DS_Store .stow-local-ignore Thumbs.db desktop.ini"

# ------------------------------------------------------------------------------
# 2. Token Splitting & Pattern Matching Utilities
# ------------------------------------------------------------------------------

# Splits space-separated tokens while preserving `\ ` escaped spaces.
# Outputs one unescaped token per line.
emit_tokens() {
    raw="${1:-}"
    [ -z "$raw" ] && return 0
    printf '%s' "$raw" | awk '
    {
        n = split($0, chars, "")
        tok = ""
        esc = 0
        for (i = 1; i <= n; i++) {
            c = chars[i]
            if (esc) {
                tok = tok c
                esc = 0
            } else if (c == "\\") {
                esc = 1
            } else if (c ~ /[ \t\r\n]/) {
                if (length(tok) > 0) {
                    print tok
                    tok = ""
                }
            } else {
                tok = tok c
            }
        }
        if (esc) tok = tok "\\"
        if (length(tok) > 0) print tok
    }'
}

is_global_ignored() {
    base=$(basename "$1")
    for name in $GLOBAL_IGNORES; do
        [ "$base" = "$name" ] && return 0
    done
    return 1
}

# Checks if relative path ($1) matches a single pattern ($2).
# Supports:
#   - `re:<regex>` (extended regex match against relative path or basename)
#   - Glob wildcards (`*` / `?` via shell case matching)
#   - Exact match or directory prefix (`$pat` or `$pat/...`)
matches_pattern() {
    rel="$1"
    pat="$2"
    [ -z "$pat" ] && return 1

    case "$pat" in
        re:*)
            rx="${pat#re:}"
            base=$(basename "$rel")
            printf '%s\n' "$rel" | grep -Eq "$rx" && return 0
            printf '%s\n' "$base" | grep -Eq "$rx" && return 0
            return 1
            ;;
        *)
            pat="${pat#/}"
            pat="${pat%/}"
            # Direct match or glob match on full relative path
            # shellcheck disable=SC2254
            case "$rel" in
                $pat|$pat/*) return 0 ;;
            esac
            # Also allow basename glob if pattern has no slash (e.g. `*.bak`)
            case "$pat" in
                */*) ;;
                *)
                    base=$(basename "$rel")
                    # shellcheck disable=SC2254
                    case "$base" in
                        $pat) return 0 ;;
                    esac
                    ;;
            esac
            return 1
            ;;
    esac
}

# Checks if relative path ($1) matches ANY token in list ($2).
# Tokens containing `:dst` strip `:dst` before matching source path.
matches_any() {
    rel="$1"
    list="$2"
    [ -z "$list" ] && return 1

    match_found=1
    while IFS= read -r tok; do
        [ -z "$tok" ] && continue
        src_pat="${tok%%:*}"
        if matches_pattern "$rel" "$src_pat"; then
            match_found=0
            break
        fi
    done <<EOF
$(emit_tokens "$list")
EOF
    return $match_found
}

# ------------------------------------------------------------------------------
# 3. Stage 1 & Stage 2 Resolution Functions
# ------------------------------------------------------------------------------

# Stage 1: Determine if relative file ($1) passes filter rules.
# Args: $1=rel_path, $2=include_list, $3=exclude_list, $4=default_mode ("allow"|"deny")
should_deploy_file() {
    rel="$1"
    inc="$2"
    exc="$3"
    def_mode="$4"

    is_global_ignored "$rel" && return 1

    # Exclude always wins
    if [ -n "$exc" ] && matches_any "$rel" "$exc"; then
        return 1
    fi

    # If include is set, act as allowlist
    if [ -n "$inc" ]; then
        matches_any "$rel" "$inc" && return 0
        return 1
    fi

    # Otherwise fall back to scope default ("allow" for user/root, "deny" for sudo_user)
    [ "$def_mode" = "allow" ] && return 0
    return 1
}

# Stage 2: Resolve mapped destination relative path for source ($1).
# Searches combined map rules ($2: explicit -*Map + strategy rules containing `:`).
# Uses longest matching prefix so nested remaps resolve accurately.
resolve_dest_rel() {
    rel="$1"
    map_rules="$2"
    best_len=0
    best_dst="$rel"

    while IFS= read -r tok; do
        case "$tok" in
            re:*) ;;
            *:*)
                src_p="${tok%%:*}"
                dst_p="${tok#*:}"
                src_p="${src_p#/}"
                src_p="${src_p%/}"
                dst_p="${dst_p#/}"
                dst_p="${dst_p%/}"
                [ -z "$src_p" ] || [ -z "$dst_p" ] && continue

                plen=${#src_p}
                if [ "$rel" = "$src_p" ]; then
                    if [ "$plen" -gt "$best_len" ]; then
                        best_len=$plen
                        best_dst="$dst_p"
                    fi
                else
                    case "$rel" in
                        "$src_p"/*)
                            if [ "$plen" -gt "$best_len" ]; then
                                best_len=$plen
                                suffix="${rel#"$src_p"/}"
                                best_dst="$dst_p/$suffix"
                            fi
                            ;;
                    esac
                fi
                ;;
        esac
    done <<EOF
$(emit_tokens "$map_rules")
EOF
    printf '%s' "$best_dst"
}

# ------------------------------------------------------------------------------
# 4. File & Symlink Execution Helpers
# ------------------------------------------------------------------------------

run_cmd() {
    use_sudo="$1"
    shift
    if [ "$use_sudo" = "1" ]; then
        sudo "$@"
    else
        "$@"
    fi
}

install_copied_file() {
    src_abs="$1"
    dst_abs="$2"
    rel_dst="$3"
    use_sudo="$4"

    run_cmd "$use_sudo" mkdir -p "$(dirname "$dst_abs")"
    run_cmd "$use_sudo" rm -f "$dst_abs"

    if [ "$use_sudo" = "1" ]; then
        case "$rel_dst" in
            etc/sudoers.d/*)
                sudo install -o root -g "$ROOT_GROUP" -m 440 "$src_abs" "$dst_abs"
                ;;
            *)
                if [ -x "$src_abs" ]; then
                    sudo install -o root -g "$ROOT_GROUP" -m 755 "$src_abs" "$dst_abs"
                else
                    sudo install -o root -g "$ROOT_GROUP" -m 644 "$src_abs" "$dst_abs"
                fi
                ;;
        esac
    else
        cp -f "$src_abs" "$dst_abs"
    fi
}

install_symlink_file() {
    src_abs="$1"
    dst_abs="$2"
    use_sudo="$3"

    run_cmd "$use_sudo" mkdir -p "$(dirname "$dst_abs")"
    run_cmd "$use_sudo" rm -f "$dst_abs"
    run_cmd "$use_sudo" ln -s "$src_abs" "$dst_abs"
}

remove_target_file() {
    dst_abs="$1"
    target_root="$2"
    use_sudo="$3"

    if [ -e "$dst_abs" ] || [ -L "$dst_abs" ]; then
        run_cmd "$use_sudo" rm -f "$dst_abs"
        # Clean up empty parent directories up to target_root
        parent=$(dirname "$dst_abs")
        norm_root="${target_root%/}"
        while [ "$parent" != "$norm_root" ] && [ "$parent" != "/" ] && [ "$parent" != "." ]; do
            run_cmd "$use_sudo" rmdir "$parent" 2>/dev/null || break
            parent=$(dirname "$parent")
        done
    fi
}

# Reconciles pre-existing absolute symlinks that already point to $src_abs_root
# so GNU Stow (which requires relative symlinks to claim ownership) does not
# abort with "existing target is not owned by stow: ...".
reconcile_existing_stow_links() {
    src_abs_root="$1"
    norm_target="$2"
    use_sudo="$3"
    def_mode="$4"
    inc_list="$5"
    exc_list="$6"

    (
        cd "$src_abs_root"
        find . \( -type f -o -type l \) | while IFS= read -r rel; do
            rel="${rel#./}"
            should_deploy_file "$rel" "$inc_list" "$exc_list" "$def_mode" || continue

            if [ "$norm_target" = "/" ]; then
                dst_abs="/$rel"
            else
                dst_abs="$norm_target/$rel"
            fi
            src_abs="$src_abs_root/$rel"

            if [ -L "$dst_abs" ]; then
                link_target=$(readlink "$dst_abs" 2>/dev/null || true)
                if [ "$link_target" = "$src_abs" ]; then
                    run_cmd "$use_sudo" rm -f "$dst_abs"
                fi
            fi
        done
    )
}

# ------------------------------------------------------------------------------
# 5. Unified Scope Processor (Handles user, sudo_user, and root)
# ------------------------------------------------------------------------------
# Uses GNU Stow when deploying 1:1 symlinks (without remaps/allowlists) and
# falls back to deterministic per-file linking/copying whenever filters,
# remaps, sudo_user, or copy rules require surgical precision.

process_scope() {
    scope_name="$1"
    src_dir="$2"
    target_dir="$3"
    use_sudo="$4"
    def_mode="$5"
    inc_list="$6"
    exc_list="$7"
    map_list="$8"
    copy_list="$9"

    [ -d "$src_dir" ] || return 0
    [ "$def_mode" = "deny" ] && [ -z "$inc_list" ] && return 0

    src_abs_root=$(cd "$src_dir" && pwd)
    norm_target="${target_dir%/}"
    [ -z "$norm_target" ] && norm_target="/"
    combined_maps="$map_list $copy_list"

    # Fast path: Pure 1:1 Stow when GNU Stow is available, default_mode=allow,
    # no include allowlist, no map rules, and no copy rules.
    if [ -n "$STOW_BIN" ] && [ "${IS_WINDOWS:-0}" != "1" ] && [ "$def_mode" = "allow" ] && [ -z "$inc_list" ] && [ -z "$(printf '%s' "$combined_maps" | tr -d '[:space:]')" ]; then
        stow_flags="--no-folding"
        for g in $GLOBAL_IGNORES; do
            esc_g=$(printf '%s' "$g" | sed 's/\./\\./g')
            stow_flags="$stow_flags --ignore=(^|/)${esc_g}\$"
        done

        # Check if any exclude rule uses shell globs (which differ from Perl regex)
        has_shell_glob=0
        while IFS= read -r tok; do
            [ -z "$tok" ] && continue
            case "$tok" in
                re:*) ;;
                *\**|*\?*) has_shell_glob=1; break ;;
            esac
        done <<EOF
$(emit_tokens "$exc_list")
EOF

        if [ "$has_shell_glob" = "0" ]; then
            while IFS= read -r tok; do
                [ -z "$tok" ] && continue
                case "$tok" in
                    re:*)
                        rx="${tok#re:}"
                        stow_flags="$stow_flags --ignore=$rx"
                        ;;
                    *)
                        clean_p="${tok#/}"
                        clean_p="${clean_p%/}"
                        esc_p=$(printf '%s' "$clean_p" | sed 's/\./\\./g')
                        stow_flags="$stow_flags --ignore=^/?${esc_p}(/|\$)"
                        ;;
                esac
            done <<EOF
$(emit_tokens "$exc_list")
EOF
            pkg_dir=$(dirname "$src_abs_root")
            pkg_sub=$(basename "$src_abs_root")
            if [ "$ACTION" = "deploy" ]; then
                echo "-> [$scope_name] Stowing $src_dir -> $target_dir"
                run_cmd "$use_sudo" mkdir -p "$target_dir"
                reconcile_existing_stow_links "$src_abs_root" "$norm_target" "$use_sudo" "$def_mode" "$inc_list" "$exc_list"
                # shellcheck disable=SC2086
                run_cmd "$use_sudo" "$STOW_BIN" $stow_flags -R -d "$pkg_dir" -t "$target_dir" "$pkg_sub"
            else
                echo "-> [$scope_name] Unstowing $src_dir from $target_dir"
                if [ -d "$target_dir" ]; then
                    reconcile_existing_stow_links "$src_abs_root" "$norm_target" "$use_sudo" "$def_mode" "$inc_list" "$exc_list"
                    # shellcheck disable=SC2086
                    run_cmd "$use_sudo" "$STOW_BIN" $stow_flags -D -d "$pkg_dir" -t "$target_dir" "$pkg_sub"
                fi
            fi
            return 0
        fi
    fi

    # Surgical per-file pipeline (handles includes, globs, remaps, copies, sudo_user, or systems without stow)
    if [ "$ACTION" = "deploy" ]; then
        echo "-> [$scope_name] Deploying $src_dir -> $target_dir"
    else
        echo "-> [$scope_name] Removing $src_dir from $target_dir"
    fi

    (
        cd "$src_abs_root"
        find . \( -type f -o -type l \) | sort | while IFS= read -r rel; do
            rel="${rel#./}"

            # Stage 1: Filter
            should_deploy_file "$rel" "$inc_list" "$exc_list" "$def_mode" || continue

            # Stage 2: Remap
            dest_rel=$(resolve_dest_rel "$rel" "$combined_maps")
            if [ "$norm_target" = "/" ]; then
                dst_abs="/$dest_rel"
            else
                dst_abs="$norm_target/$dest_rel"
            fi
            src_abs="$src_abs_root/$rel"

            # Stage 3: Strategy (Copy vs. Symlink)
            if [ "$ACTION" = "deploy" ]; then
                if [ -n "$copy_list" ] && matches_any "$rel" "$copy_list"; then
                    install_copied_file "$src_abs" "$dst_abs" "$dest_rel" "$use_sudo"
                elif [ "${IS_WINDOWS:-0}" = "1" ]; then
                    install_copied_file "$src_abs" "$dst_abs" "$dest_rel" "$use_sudo"
                else
                    install_symlink_file "$src_abs" "$dst_abs" "$use_sudo"
                fi
            else
                remove_target_file "$dst_abs" "$norm_target" "$use_sudo"
            fi
        done
    )
}

# ------------------------------------------------------------------------------
# 6. Main Execution Entrypoint
# ------------------------------------------------------------------------------

echo "${ACTION}: Package '$PKG' (Unix Helper)"

# Scope 1: USER (<PKG>/USER -> $USER_TARGET)
process_scope "user" "$PKG/USER" "$USER_TARGET" "0" "allow" \
    "$USER_INCLUDE" "$USER_EXCLUDE" "$USER_MAP" "$USER_COPY"

# Scope 2: SUDO_USER (<PKG>/USER -> $SUDO_USER_TARGET, default-deny unless included)
if [ "$SKIP_SUDO" != "1" ] && [ "${IS_WINDOWS:-0}" != "1" ]; then
    process_scope "sudo_user" "$PKG/USER" "$SUDO_USER_TARGET" "1" "deny" \
        "$SUDO_INCLUDE" "$SUDO_EXCLUDE" "$SUDO_MAP" "$SUDO_COPY"
fi

# Scope 3: ROOT (<PKG>/ROOT -> $ROOT_TARGET)
process_scope "root" "$PKG/ROOT" "$ROOT_TARGET" "1" "allow" \
    "$ROOT_INCLUDE" "$ROOT_EXCLUDE" "$ROOT_MAP" "$ROOT_COPY"
